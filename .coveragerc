[run]
branch = True
source = backend/app
omit =
    */tests/*
    */__pycache__/*
    */seeds/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
